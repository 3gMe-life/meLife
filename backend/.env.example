# Server Configuration
NODE_ENV=development
PORT=5001

APP_NAME=3G_ME_LIFE_API
API_VERSION=v1

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/melife

# JWT Access Token Configuration
# Generate secure 64-byte random secret: openssl rand -base64 64
JWT_ACCESS_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=3g-me-life
JWT_AUDIENCE=3g-me-life-users

# Refresh Token & Session Configuration
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
REFRESH_TOKEN_BYTES=64

# Cookie Settings
REFRESH_COOKIE_NAME=melife_refresh_token
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_PATH=/api/v1/auth
COOKIE_DOMAIN=

# Argon2 Password Hashing Parameters
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Google OAuth Client
GOOGLE_CLIENT_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
